# ==============================================================================
# SchemeSetu Frontend Environment Configuration Template
# Copy to .env and adjust variables as needed.
# ==============================================================================

# Backend API Base URL
VITE_API_URL=http://localhost:8000/api/v1

# Backend Health Check URL (optional)
VITE_HEALTH_URL=http://localhost:8000/health

# Application Title
VITE_APP_TITLE=SchemeSetu

# Meta WhatsApp Business Platform (Set your verified WABA phone number, e.g. 919876543210)
VITE_WHATSAPP_BUSINESS_NUMBER=
VITE_WHATSAPP_DISPLAY_NUMBER=
