# ==============================================================================
# SchemeSetu Backend Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Application
APP_NAME=SchemeSetu
PROJECT_NAME="SchemeSetu API"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database — MongoDB / PyMongo Async
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=schemesetu
MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000

# AI / LLM — Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.2

# CORS (JSON array or comma-separated URLs)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","*"]

# Google Cloud & Cloud DLP (Tier 2 defense-in-depth)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
DLP_ENABLED=false
DLP_INTEGRATION_TESTS=false
DLP_TIMEOUT_SECONDS=2.0

# Rate Limiting
RATE_LIMIT_CHAT_PER_SESSION=60
RATE_LIMIT_UPLOAD_PER_SESSION=10

# OCR Token Expiry
OCR_CONFIRMATION_EXPIRY_MINUTES=10

# Admin Seeding & Security
ENABLE_ADMIN_SEED_ENDPOINT=false
ADMIN_API_KEY=
JWT_SECRET_KEY=schemesetu-insecure-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Scraper Configuration (Firecrawl optional)
FIRECRAWL_API_KEY=

# Multi-Channel: Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v19.0

# Voice Services (STT & TTS)
SPEECH_TO_TEXT_LANGUAGE=en-IN
TEXT_TO_SPEECH_LANGUAGE=en-IN
GOOGLE_SPEECH_API_KEY=
